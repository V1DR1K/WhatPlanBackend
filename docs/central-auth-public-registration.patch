+package com.avianto.auth.user;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import com.avianto.auth.api.ApiException;
+import com.avianto.auth.auth.RefreshTokenRepository;
+import org.junit.jupiter.api.Test;
+import org.springframework.security.crypto.password.PasswordEncoder;
+
+class UserServiceRegistrationTest {
+    @Test
+    void normalizesUsernameAndStoresOnlyAnEncodedPassword() {
+        var users = mock(UserRepository.class);
+        var passwords = mock(PasswordEncoder.class);
+        var refreshTokens = mock(RefreshTokenRepository.class);
+        when(users.existsByUsernameIgnoreCase("new.user")).thenReturn(false);
+        when(passwords.encode("a-long-password")).thenReturn("{bcrypt}encoded-password");
+        when(users.save(any(User.class))).thenAnswer(invocation -> invocation.getArgument(0));
+        var service = new UserService(users, passwords, refreshTokens);
+
+        User created = service.register(" New.User ", "a-long-password");
+
+        assertThat(created.getUsername()).isEqualTo("new.user");
+        assertThat(created.getPasswordHash()).isEqualTo("{bcrypt}encoded-password");
+        assertThat(created.isEnabled()).isTrue();
+        assertThat(created.isMustChangePassword()).isFalse();
+        assertThat(created.getStatus()).isEqualTo("ACTIVE");
+        verify(users).existsByUsernameIgnoreCase("new.user");
+    }
+
+    @Test
+    void rejectsDuplicateUsernameWithoutRevealingWhetherItExists() {
+        var users = mock(UserRepository.class);
+        when(users.existsByUsernameIgnoreCase("new.user")).thenReturn(true);
+        var service = new UserService(users, mock(PasswordEncoder.class), mock(RefreshTokenRepository.class));
+
+        assertThatThrownBy(() -> service.register("NEW.USER", "a-long-password"))
+                .isInstanceOf(ApiException.class)
+                .hasMessage("No se pudo completar el registro");
+        verify(users).existsByUsernameIgnoreCase("new.user");
+    }
+
+    @Test
+    void rejectsInvalidUsernamesBeforeAnyAccountLookup() {
+        var users = mock(UserRepository.class);
+        var service = new UserService(users, mock(PasswordEncoder.class), mock(RefreshTokenRepository.class));
+
+        assertThatThrownBy(() -> service.register("x", "a-long-password"))
+                .isInstanceOf(ApiException.class);
+    }
+}
